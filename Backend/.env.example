# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080
# The public origin of the web app. Email templates build absolute image URLs
# from this, and those images are fetched by the RECIPIENT'S mail provider —
# not by this server. A localhost value means Gmail and Outlook cannot reach
# them, so every logo and icon in your emails renders broken.
# Must be a publicly reachable https host to test email images.
APP_URL=https://lizexpressltd.com
ADMIN_URL=https://admin.lizexpressltd.com
CORS_ORIGINS=http://localhost:5173,https://lizexpressltd.com,https://www.lizexpressltd.com,https://admin.lizexpressltd.com

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server only — never expose
SUPABASE_JWT_SECRET=super-secret-jwt-secret
# Private bucket: identity (KYC) documents only. Keep it PRIVATE.
SUPABASE_STORAGE_BUCKET=lizexpress
# Public bucket: item, advert and profile photos.
SUPABASE_PUBLIC_BUCKET=items
# Public bucket: profile pictures.
SUPABASE_AVATAR_BUCKET=avatars
# Private bucket where v1 stored identity documents (read-only, for admin review).
SUPABASE_LEGACY_KYC_BUCKET=verification

# ── Resend (transactional email + OTP delivery) ──────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL="LizExpress <no-reply@lizexpressltd.com>"
RESEND_REPLY_TO=support@lizexpressltd.com

# ── OTP policy ───────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Flutterwave ──────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx     # server only
FLUTTERWAVE_ENCRYPTION_KEY=xxxx
FLUTTERWAVE_WEBHOOK_HASH=your_secret_hash
PAYMENT_CURRENCY=NGN
LISTING_FEE_PERCENTAGE=5

# ── Web Push (VAPID) ─────────────────────────────────────
# generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BFxxxx
VAPID_PRIVATE_KEY=xxxx
VAPID_SUBJECT=mailto:support@lizexpressltd.com

# ── Misc ─────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=6Lxxxx
LOG_LEVEL=info

# Vercel Cron: any long random text; Vercel sends it to /api/v1/adverts/cron/expire daily
CRON_SECRET=
