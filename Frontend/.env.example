# API base URL. In local development the Vite proxy forwards /api to
# http://localhost:8080, so this can be left as the relative default.
VITE_API_URL=/api/v1
# Production: VITE_API_URL=https://api.lizexpressltd.com/api/v1

# Supabase — used ONLY for the Realtime WebSocket. Both values are public.
# Never put the service-role key here; it would ship to every browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin console host. The public site sends /admin/* here in production.
VITE_ADMIN_HOST=admin.lizexpressltd.com
# Set to true to preview the admin-only app on localhost.
VITE_FORCE_ADMIN=false

# Supabase image resizing (smaller photos on phones). Paid Supabase plans only:
# on the free plan resized URLs fail. Leave false unless your plan includes
# "Image Transformations". Photos fall back to the original if resizing fails.
VITE_SUPABASE_IMAGE_TRANSFORMS=false
